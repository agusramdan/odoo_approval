<odoo>
    <record id="view_approval_instance_form" model="ir.ui.view">
        <field name="name">approval.instance</field>
        <field name="model">approval.instance</field>
        <field name="priority" eval="16"/>
        <field name="inherit_id" ref="amr_approval.view_approval_instance_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="PDF Signature" attrs="{'invisible': [('pdf_document_id','=',False)]}">
                    <group>
                        <field name="pdf_document_id"/>
                        <field name="pdf_filename" readonly="1"/>
                        <field name="pdf_file" filename="pdf_filename" readonly="1" widget="pdf_viewer"/>
                        <field name="signed_pdf_filename" readonly="1"/>
                        <field name="signed_pdf" filename="signed_pdf_filename" readonly="1" widget="pdf_viewer"/>
                    </group>
                </page>
            </notebook>
        </field>

    </record>

    <record id="view_approval_instance_pdf_document_form" model="ir.ui.view">
        <field name="name">approval.instance</field>
        <field name="model">approval.instance</field>
        <field name="priority" eval="1000"/>
        <field name="arch" type="xml">
            <form string="PDF Signature"  edit="false" create="false" delete="false">
                 <group>
                     <field name="pdf_document_id" readonly="1" groups="base.group_no_one"/>
                     <field name="pdf_filename" readonly="1"/>
                     <field name="pre_signed_pdf" filename="pdf_filename" readonly="1" widget="pdf_viewer"/>
                 </group>
                <footer>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
