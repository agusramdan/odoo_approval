<odoo>
    <record id="view_approval_document_form" model="ir.ui.view">
        <field name="name">approval.document</field>
        <field name="model">approval.document</field>
        <field name="priority" eval="16"/>
        <field name="inherit_id" ref="amr_approval.view_approval_document_form"/>
        <field name="arch" type="xml">
            <field name="pdf_sign_server" position="after">
                <field name="pdf_sign_template_id" attrs="{'invisible': [('pdf_sign_server','!=','local')]}" />
            </field>
        </field>

    </record>

</odoo>
