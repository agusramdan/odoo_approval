<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Wizard Form                                               -->
    <!-- ========================================================= -->

    <record id="view_report_composer_wizard_form" model="ir.ui.view">
        <field name="name">report.composer.wizard.form</field>
        <field name="model">report.composer.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Composer">
                <sheet>
                    <div class="mb-2">
                        <button
                            name="action_select_all"
                            type="object"
                            string="Select All"
                            class="btn-secondary"
                        />

                        <button
                            name="action_unselect_all"
                            type="object"
                            string="Unselect All"
                            class="btn-secondary"
                        />
                    </div>
                    <!-- Hidden source information -->
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>

                    <!-- Report -->
                    <group string="Report">
                        <group>
                            <field name="report_id"
                                   options="{'no_create': True,
                                            'no_create_edit': True}"/>

                            <field name="report_position"
                                   widget="radio"/>
                        </group>
                    </group>

                    <!-- Attachments -->
                    <group string="Attachments">

                        <field name="line_ids"
                               nolabel="1">
                            <tree create="false" delete="false" editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="selected"/>
                                <field name="attachment_id"/>
                                <field name="file_type"/>
                                <field name="mimetype"/>
                                <field name="file_size"/>
                            </tree>

                        </field>

                    </group>

                </sheet>

                <footer>

                    <button name="action_generate"
                            string="Generate PDF"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Optional Action                                           -->
    <!-- ========================================================= -->

    <record id="action_report_composer_wizard"
            model="ir.actions.act_window">

        <field name="name">Report Composer</field>
        <field name="res_model">report.composer.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_report_composer_wizard_form"/>
        <field name="target">new</field>

    </record>


</odoo>
