<odoo>
    <record id="view_users_form_inherit_signature" model="ir.ui.view">
        <field name="name">res.users.form.signature</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page string="Signature">

                    <group>
                        <field name="signature_image"
                               widget="image"
                               filename="signature_image_filename"
                               style="max-width: 300px; max-height: 150px;"/>

                        <field name="signature_image_filename"
                               invisible="1"/>
                    </group>

                </page>

            </xpath>

        </field>
    </record>
</odoo>
