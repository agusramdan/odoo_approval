<odoo>
    <data>
        <record id="view_company_form_inherit_approval" model="ir.ui.view">
            <field name="name">res.company.form.approval</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page name="configuration_approval" string="Approval Config">
                        <group string="Approval">
                            <field name="approval_email_layout_xmlid" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
