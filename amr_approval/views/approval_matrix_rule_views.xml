<odoo>
    <!-- TREE VIEW -->
    <record id="view_approval_matrix_rule_tree" model="ir.ui.view">
        <field name="name">approval.matrix.rule.tree</field>
        <field name="model">approval.matrix.rule</field>
        <field name="arch" type="xml">
            <tree string="Matrix Tiered" default_order="priority">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_approval_matrix_rule_form" model="ir.ui.view">
        <field name="name">approval.matrix.rule.form</field>
        <field name="model">approval.matrix.rule</field>
        <field name="arch" type="xml">
            <form string="Approval Matrix Tiered">
                <header>
                    <field name="active" invisible="1"/>
                    <!--                    <button name="action_try_config"-->
                    <!--                            string="Try Config"-->
                    <!--                            type="object"-->
                    <!--                            class="btn-secondary"/>-->
                </header>
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"/>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
<!--                        <group>-->
<!--                            <field name="requester_group_ids" options="{'no_create': True}" widget="many2many_tags"/>-->
<!--                        </group>-->
                        <group>
                            <field name="priority"/>
                            <!--                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>-->
                        </group>
                    </group>
                    <notebook>
                        <page string="List Config">
                            <field name="approval_matrix_rule_line">
                                <tree editable="bottom" open_form_view="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="type_approval"/>
                                    <field name="user_ids" widget="many2many_tags"
                                           attrs="{'invisible': [('type_approval', '!=', 'user')]}"
                                    />
                                    <field name="group_ids" widget="many2many_tags"
                                           attrs="{'invisible': [('type_approval', '!=', 'group')]}"
                                    />
                                    <field name="responsible_mode" string="Mode"
                                           attrs="{'invisible': [('type_approval', '!=', 'model')]}"
                                    />
                                    <field name="responsible_model" invisible="1"/>
                                    <field name="responsible_id" invisible="1"/>
                                    <field name="responsible_rule_id"
                                           attrs="{'invisible': ['|',('type_approval', '!=', 'model'),('responsible_mode', '=', 'select')],'required': [('type_approval', '=', 'model'),('responsible_mode', '!=', 'select')]}"
                                    />
                                    <field name="responsible_ref" string="Selected"
                                           attrs="{'invisible': ['|',('type_approval', '!=', 'model'),('responsible_mode', '!=', 'select')],'required': [('type_approval', '=', 'model'),('responsible_mode', '=', 'select')]}"
                                    />
                                    <field name="condition_select"/>
                                    <button
                                            name="action_open_line"
                                            type="object"
                                            icon="fa-external-link"
                                    />
                                    <field name="condition_range"
                                           attrs="{'invisible': [('condition_select', 'not in', ['tiring','limit','range'])]}"
                                    />
                                    <field name="condition_range_min"
                                           attrs="{'invisible': [('condition_select', 'not in', ['tiring','range'])]}"
                                    />
                                    <field name="condition_range_max"
                                           attrs="{'invisible': [('condition_select', 'not in', ['limit','range'])]}"
                                    />
                                    <field name="reject_to_method" optional="hide" />
                                    <field name="reject_to_line_id" optional="hide"
                                           attrs="{'invisible': [('reject_to_method', '!=', 'to_task_line')],'required': [('reject_to_method', '!=', 'to_task_line')]}"
                                           domain="[('approval_matrix_rule_id','=',parent.id)]"
                                    />
                                </tree>

                            </field>
                        </page>
                        <page string="Condition">
                            <group>
                                <field name="condition_select"/>
                            </group>
                            <group attrs="{'invisible': [('condition_select', 'not in', ['tiring','limit','range'])]}">
                                <field name="condition_range"/>
                                <field name="condition_range_min"
                                       attrs="{'invisible': [('condition_select', 'not in', ['tiring','range'])]}"/>
                                <field name="condition_range_max"
                                       attrs="{'invisible': [('condition_select', 'not in', ['limit','range'])]}"/>
                            </group>
                            <group attrs="{'invisible': [('condition_select', '!=', 'python')]}">
                                <field name="condition_python" widget="ace" options="{'mode': 'python'}" nolabel="1" colspan="4"/>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="note"/>
                        </page>
                        <page string="Python Code" name="code" autofocus="autofocus" >
                            <field name="code" widget="ace" options="{'mode': 'python'}"
                                   placeholder="Enter Python code here. Help about Python expression is available in the help tab of this document."
                            />
                        </page>

                        <page string="Help" name="help_info"  >
                            <div style="margin-top: 4px;">
                                <h3>Help with Python expressions</h3>
                                <p>Various fields may use Python code or Python expressions. The following variables can be used:</p>
                                <ul>
                                    <li><code>env</code>: Odoo Environment on which the action is triggered</li>
                                    <li><code>approval_line</code>: Input and result this scrip</li>
                                    <li><code>transaction_object</code>: TODO </li>
                                    <li><code>time</code>, <code>datetime</code>, <code>dateutil</code>, <code>timezone</code>: useful Python libraries</li>
                                    <li><code>log(message, level='info')</code>:logging function to record debug information in <code>ir.logging</code> table</li>
                                    <li><code>UserError</code>: Warning Exception to use with <code>raise</code></li>
                                    <li>To return an response, assign: <code> = {...}</code></li>
                                    <li>Bila ingin custom approval line bisa memasukan data ke response['approval_line']</li>
                                </ul>
                                <div >
                                    <p>Example of Python code</p>
<code style="white-space: pre-wrap">

</code>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <footer/>
            </form>
        </field>
    </record>

    <record id="view_approval_matrix_rule_line_form" model="ir.ui.view">
        <field name="name">approval.matrix.rule.line.form</field>
        <field name="model">approval.matrix.rule.line</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_approval"/>
                            <field name="user_ids" widget="many2many_tags" attrs="{'invisible': [('type_approval', '!=', 'user')]}"/>
                            <field name="group_ids" widget="many2many_tags" attrs="{'invisible': [('type_approval', '!=', 'group')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Condition">
                            <group>
                                <field name="condition_select"/>
                            </group>
                            <group attrs="{'invisible': [('condition_select', 'not in', ['tiring','limit','range'])]}">
                                <field name="condition_range"/>
                                <field name="condition_range_min"  attrs="{'invisible': [('condition_select', 'not in', ['tiring','range'])]}"/>
                                <field name="condition_range_max" attrs="{'invisible': [('condition_select', 'not in', ['limit','range'])]}"/>
                            </group>
                            <group attrs="{'invisible': [('condition_select', '!=', 'python')]}">
                                <field name="condition_python" widget="ace" options="{'mode': 'python'}" nolabel="1" colspan="4"/>
                            </group>
                        </page>
                        <page string="Model" attrs="{'invisible': [('type_approval', '!=', 'model')]}">
                            <group>
                                <field name="responsible_mode" string="Mode"/>
                                <field name="responsible_model" invisible="1"/>
                                <field name="responsible_id" invisible="1"/>
                                <field name="responsible_rule_id"
                                       attrs="{'invisible': [('responsible_mode', '=', 'select')],'required': [('type_approval', '!=', 'model'),('responsible_mode', '!=', 'select')]}"
                                />
                                <field name="responsible_ref" string="Selected"
                                       attrs="{'invisible': [('responsible_mode', '!=', 'select')]}"
                                />
    <!--                            <field name="responsible_id" widget="many2one_reference" options="{'model_field': 'model_name'}" />-->
                                <field name="responsible_field" string="Field"
                                       attrs="{'invisible': [('responsible_mode', '!=', 'field')]}"
                                />
                                <field name="responsible_function" string="Function"
                                       attrs="{'invisible': [('responsible_mode', '!=', 'function')]}"
                                />
                                <field name="responsible_code" string="Code"
                                       widget="ace" options="{'mode': 'python'}"
                                       attrs="{'invisible': [('responsible_mode', '!=', 'code')]}"
                                />
                            </group>
                            <group string="Build Approval Task Line">
                                <field name="responsible_strategy" string="Strategy"/>
                                <field name="responsible_custom" string="Custom"
                                       widget="ace" options="{'mode': 'python'}"
                                       attrs="{'invisible': [('responsible_strategy', '!=', 'custom')]}"
                                />
                            </group>

                        </page>
<!--                        <page string="Test">-->
                            <!--                            <separator string="Test"/>-->
                            <!--                            <group>-->
                            <!--                                <field name="test_value"/>-->
                            <!--                                <field name="test_result" readonly="1"/>-->
                            <!--                            </group>-->
<!--                        </page>-->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_approval_matrix_rule" model="ir.actions.act_window">
        <field name="name">Approval Matrix Tiered</field>
        <field name="res_model">approval.matrix.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your Approval Matrix Tiered
            </p>
        </field>
    </record>

</odoo>
