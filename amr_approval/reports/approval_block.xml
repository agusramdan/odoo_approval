<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <template id="approval_block">
            <t t-if="approval['enabled']">
                <style>
                    .approval-table {
                        width: 100%;
                        table-layout: fixed;
                        border-collapse: collapse;
                        font-size: 12px;
                        border: 1px solid black;
                        border-top: none;
                    }

                    .approval-cell {
                        text-align: center;
                        vertical-align: top;
                        padding: 12px 6px 10px 6px;
                    }

                    .approval-container {
                        width: 100%;
                        text-align: center;
                    }

                    .approval-item {
                        display: inline-block;
                        vertical-align: top;
                        text-align: center;
                        padding: 12px 6px 10px 6px;
                        box-sizing: border-box;
                    }

                    .approval-role {
                        height: 24px;
                        line-height: 12px;
                        overflow: hidden;
                        font-size: 10px;
                        font-weight: bold;
                        text-transform: uppercase;
                        letter-spacing: 0.4px;
                    }

                    .approval-visual {
                        height: 70px;
                        text-align: center;
                    }

                    .approval-visual img {
                        max-width: 140px;
                        max-height: 60px;
                    }

                    .approval-user {
                        height: 28px;
                        line-height: 14px;
                        overflow: hidden;
                        margin-top: 2px;
                        font-size: 11px;
                    }

                    .approval-state {
                        font-size: 9px;
                    }
                </style>
                <t t-if="layout == 'table'">
                    <t t-call="amr_approval.approval_table"/>
                </t>

                <t t-elif="layout == 'div'">
                    <t t-call="amr_approval.approval_div"/>
                </t>

            </t>

        </template>

        <template id="approval_table">
            <table class="approval-table">
                <tbody>
                    <tr>
                        <t t-foreach="approval['lines']" t-as="line">
                            <td class="approval-cell">

                                <div class="approval-role">
                                    <span t-esc="line['label']"/>
                                </div>

                                <div class="approval-visual">
                                    <t t-call="amr_approval.approval_visuals">
                                        <t t-set="visuals"
                                           t-value="line['visuals']"/>
                                    </t>
                                </div>

                                <div class="approval-user">
                                    <span t-esc="line['user']['name']"/>
                                </div>

                                <div t-att-class="
                                    'approval-state ' + line['state'].get('css_class', '')
                                ">
                                    <span t-esc="line['state']['label']"/>
                                </div>

                            </td>
                        </t>
                    </tr>
                </tbody>
            </table>
        </template>

        <template id="approval_div">
            <div class="approval-container">
                <t t-foreach="approval['lines']" t-as="line">
                    <div class="approval-item">
                        <div class="approval-role">
                            <span t-esc="line['label']"/>
                        </div>
                        <div class="approval-visual">
                            <t t-call="amr_approval.approval_visuals">
                                <t t-set="visuals"
                                   t-value="line['visuals']"/>
                            </t>
                        </div>
                        <div class="approval-user">
                            <span t-esc="line['user']['name']"/>
                        </div>
                        <div t-att-class="
                            'approval-state ' + line['state']['css_class']
                        ">
                            <span t-esc="line['state']['label']"/>
                        </div>
                    </div>
                </t>
            </div>
        </template>

        <template id="approval_visuals">
            <div class="approval-visuals">
                <t t-foreach="visuals" t-as="visual">
                    <div
                        t-att-class="'approval-visual-' + visual['type']"
                        t-att-style="visual.get('style')"
                    />
                </t>
            </div>
        </template>
    </data>
</odoo>
