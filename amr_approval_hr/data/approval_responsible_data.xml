<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="approval_responsible_hr_employee" model="approval.responsible">
            <field name="name">Approval Employee</field>
            <field name="model_id" ref="hr.model_hr_employee"/>

            <field name="hierarchy" eval="True"/>
            <field name="hierarchy_select">field</field>
            <field name="hierarchy_field">manager_id</field>

            <field name="representative" eval="True"/>
            <field name="representative_select">field</field>
            <field name="representative_field">user_id</field>

        </record>

        <record id="approval_responsible_hr_department" model="approval.responsible">
            <field name="name">Department</field>
            <field name="model_id" ref="hr.model_hr_department"/>

            <field name="hierarchy" eval="True"/>
            <field name="hierarchy_select">field</field>
            <field name="hierarchy_field">parent_id</field>

            <field name="representative" eval="True"/>
            <field name="representative_select">field</field>
            <field name="representative_field">manager_id</field>

            <field name="members" eval="True"/>
            <field name="members_select">field</field>
            <field name="members_field">member_ids</field>
        </record>

        <record id="approval_responsible_hr_job" model="approval.responsible">
            <field name="name">Job Position</field>
            <field name="model_id" ref="hr.model_hr_job"/>

            <field name="members" eval="True"/>
            <field name="members_select">field</field>
            <field name="members_field">employee_ids</field>
        </record>

    </data>
</odoo>
